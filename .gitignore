# ============================================
# TRACK Project - Git Ignore File
# ============================================

# Node.js / Webapp
# ============================================
webapp/node_modules/
webapp/package-lock.json
webapp/.env
webapp/*.log
webapp/npm-debug.log*
webapp/yarn-debug.log*
webapp/yarn-error.log*
webapp/.DS_Store

# Server logs
/tmp/track-server.log
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Environment variables
.env
.env.local
.env.*.local

# Database files (if any local)
*.db
*.sqlite
*.sqlite3

# Docker temporary files
docker-compose.override.yml
*.dockerignore

# Oracle Instant Client (if copied locally)
instantclient_*/
/opt/oracle/

# MongoDB data (if local)
mongodb-data/
/data/

# IDE / Editor files
# ============================================
# VSCode
.vscode/
*.code-workspace
.history/

# IntelliJ / WebStorm
.idea/
*.iml
*.iws
*.ipr
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.*.un~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock

# OS generated files
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Backup files
*.bak
*.backup
*.old
*.orig

# Temporary files
tmp/
temp/
*.tmp

# Compiled files
*.class
*.jar
*.war
*.ear

# Package files (if any)
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Sensitive data
# ============================================
# Credentials (if you accidentally put them)
*secret*
*password*
*.pem
*.key
*.crt
*.p12

# Custom data files (don't commit sample data if sensitive)
# But DO commit your schema (tables.txt, create.txt)
!sql/tables.txt
!sql/create.txt
!sql/data.txt  # Optional: commit if it's just sample data

# MongoDB init scripts (commit the structure, not data if sensitive)
!mongo/*.txt

# Project specific
# ============================================
# Start script may have custom paths (but keep the script itself)
# start.sh is fine to commit

# Session storage
session-store/
sessions/

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# Typings
typings/

# Optional: if you use TypeScript
*.tsbuildinfo

# Optional: if you use webpack
dist/
build/
.next/
.nuxt/

# Environment-specific
.env.production
.env.staging
.env.development
